# Professional Netoval Dockerfile
# Multi-stage build for optimized image size

FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04 AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements
COPY requirements_professional.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements_professional.txt

# Download models during build
RUN python3 -c "from ultralytics import YOLO; YOLO('yolov8s-pose.pt'); YOLO('yolov8n.pt')" && \
    mkdir -p models

# Production stage
FROM base AS production

WORKDIR /app

# Copy application code
COPY . .

# Create directories
RUN mkdir -p uploads logs models && \
    chmod -R 755 uploads logs

# Set environment
ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=app_professional.py
ENV FLASK_ENV=production

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Expose port
EXPOSE 5000

# Run application
CMD ["gunicorn", \
     "--workers=4", \
     "--worker-class=sync", \
     "--bind=0.0.0.0:5000", \
     "--timeout=120", \
     "--access-logfile=-", \
     "--error-logfile=-", \
     "app_professional:app"]
