# ============ Web application ============
# DeepSeek used for coaching chat only once a completed analysis exists.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Postgres/MySQL database URL used by drizzle.
DATABASE_URL=

# Long random string that signs sign-in cookies (required).
JWT_SECRET=
# This email becomes an admin when it registers.
ADMIN_EMAIL=

# Uploaded videos are stored on the app server's disk; mount a persistent volume here in production.
STORAGE_DIR=uploads

# Publicly reachable URL of the app — used to build the worker completion webhook.
PUBLIC_APP_URL=
WORKER_CALLBACK_SECRET=

# ============ RunPod serverless GPU worker ============
# Queue-based endpoint root, e.g. https://api.runpod.ai/v2/ENDPOINT_ID
CV_WORKER_URL=
CV_WORKER_TOKEN=
CV_WORKER_EXECUTION_TIMEOUT_MS=900000
CV_WORKER_TTL_MS=3600000

# Warm-keep: keeps ONE GPU worker alive so the first analysis skips cold start.
# Set to "false" overnight to stop idle GPU cost.
CV_WORKER_KEEP_WARM_ENABLED=true
CV_WORKER_KEEP_WARM_INTERVAL_MS=12000

# Client-triggered warmup throttle (prevents warmup job spam when users select
# videos repeatedly).
CV_WORKER_WARMUP_COOLDOWN_MS=60000
CV_WORKER_WARMUP_TIMEOUT_MS=120000
CV_WORKER_WARMUP_TTL_MS=180000

# ============ Optional legacy local (v3) stack ============
REDIS_URL=redis://localhost:6379/0
SHUTTLE_MODEL_PATH=models/shuttlecock_yolov8n.pt
